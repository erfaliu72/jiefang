#!/usr/bin/expect -f
set timeout 60
set password "fijSec-tuccyt-9dohxu"
set server "8.156.91.120"

spawn ssh -o StrictHostKeyChecking=no root@$server
expect "password:"
send "$password\r"
expect "# "

puts "==> Fix 1: Rewrite .env with export prefix..."
send "cat > /opt/jinjuyuan/.env << 'EOF'
export JJY_DB_HOST=rm-2vc15as5od6ay3gl4zo.mysql.cn-chengdu.rds.aliyuncs.com
export JJY_DB_PORT=3306
export JJY_DB_USER=dbroot
export JJY_DB_PASSWORD=fijSec-tuccyt-9dohxu
export JJY_DB_NAME=jinjuyuan
export JJY_SECRET_KEY=jinjuyuan-prod-2026-changeme
EOF
echo ENV_FIXED\r"
expect "ENV_FIXED"

puts "==> Fix 2: Update systemd service to export env vars explicitly..."
send "cat > /etc/systemd/system/jinjuyuan.service << 'EOF'
[Unit]
Description=Jinjuyuan Vehicle Management System
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/jinjuyuan
EnvironmentFile=/opt/jinjuyuan/.env
ExecStart=/bin/bash -c 'set -a; source /opt/jinjuyuan/.env; set +a; exec /opt/jinjuyuan-venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 0.0.0.0:8081 wsgi:application'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
echo SERVICE_FIXED\r"
expect "SERVICE_FIXED"

puts "==> Fix 3: Reload systemd and restart..."
send "systemctl daemon-reload && systemctl restart jinjuyuan && sleep 5 && systemctl is-active jinjuyuan && echo ACTIVE_OK\r"
expect "ACTIVE_OK"

puts "==> Verify..."
send "curl -s -o /dev/null -w '%%{http_code}' http://127.0.0.1:8081/\r"
expect -re "(\\d+)"
puts "HTTP: $expect_out(1,string)"

send "exit\r"
expect eof
puts "\n=== DONE ==="
