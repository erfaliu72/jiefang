flowchart TD
    A["运营端：上传新车 Excel"] --> B["系统按车架号 VIN 去重入库"]
    B --> C["车辆进入车库 / 状态：在库"]
    C --> D["销售端：销售报单 / 新建报单"]
    D --> E["选择在库车辆"]
    E --> F["销售方式：整车销售"]
    F --> G["填写客户、成交价、定金/首付款、收款信息"]
    G --> H["整车销售不做指导价确认"]
    H --> L["财务端：确认销售报单"]
    L --> M["财务直接确认<br/>不上传车场/厂家分期表<br/>不做分期表价格比对"]
    M --> N["车辆锁定<br/>报单状态：已激活"]
    N --> O["运营端：上传线下卖车合同"]
    O --> P["合同状态：待首付款/待收款"]
    P --> Q["运营端：发起首次付款或整车收款"]
    Q --> R["运营端：上传客户付款截图"]
    R --> S["财务端：上传公司收款清单<br/>核对实际到账"]
    S --> T{"首次付款/约定收款是否足额？"}
    T -- "足额" --> U["财务确认无误"]
    U --> V["合同状态：待出库"]
    T -- "不足额" --> W["销售在首期对账单上报实收金额<br/>备注不足原因和剩余金额承诺归还时间"]
    W --> X["不足部分挂账为应收<br/>承诺期内不记录万5滞纳金"]
    X --> Y["老板审批不足额出库"]
    Y -- "同意" --> Z["车辆继续锁定<br/>允许出库"]
    Z --> V
    Y -- "不同意" --> AA["老板发起退款"]
    AA --> AB["财务执行退款流程"]
    AB --> AC["本单结束<br/>报单/合同终止，车辆释放回在库"]
    V --> AD["车管端：上传出库照片/出库单"]
    AD --> AE["车管点击：确认出库"]
    AE --> AF["车辆状态：已售"]
    AF --> AG["卖车流程结束"]
    AH["老板端"] --> AI["查看全过程：入库、报单、审批、合同、收款、出库、利润"]
