flowchart TD
    A["销售端：销售报单 / 新建报单"] --> B["选择车辆：在库车辆"]
    B --> C["销售方式：整车销售"]
    C --> D["填写客户、成交价、定金/首付款、收款信息"]
    D --> E["系统生成报单并锁定车辆"]
    E --> F{"成交价低于指导价？"}
    F -- "否" --> G["财务端：审批中心 / 报单确认"]
    F -- "是" --> H["老板端：审批中心 / 价格特批"]
    H --> I{"老板审批结果"}
    I -- "驳回" --> J["流程结束：价格特批驳回"]
    I -- "通过" --> G
    G --> K["财务点击：确认报单"]
    K --> L["报单状态：已激活"]
    L --> M["运营端：销售报单 / 转合同"]
    M --> N["运营生成卖车合同"]
    N --> O["合同状态：待审批"]
    O --> P["财务端：审批中心 / 合同审批"]
    P --> Q{"财务是否通过？"}
    Q -- "驳回" --> R["合同退回运营修改"]
    Q -- "通过" --> S["合同状态：待首付款"]
    S --> T["运营端：发起首付款及押金支付流程"]
    T --> U["运营上传客户付款截图"]
    U --> V["财务端：审批中心 / 首次付款"]
    V --> W["财务上传银行到账回单"]
    W --> X["财务点击：通过"]
    X --> Y["合同状态：待出库"]
    Y --> Z["运营端：发起车辆出库"]
    Z --> AA["财务端：确认合同和款项无误"]
    AA --> AB["车管端：审批中心 / 车辆出库"]
    AB --> AC["车管上传出库照片、出库单照片"]
    AC --> AD["车管点击：确认出库"]
    AD --> AE["车辆状态：已售"]
    AE --> AF["卖车流程结束"]
    AG["老板端"] --> AH["查看全过程：报单、审批、合同、付款、出库、利润"]
