flowchart TD
    A["运营端：上传新车 Excel"] --> B["系统解析车辆清单"]
    B --> C{"逐行按车架号 VIN<br/>与后台全部车辆比对"}
    C -- "VIN 已存在" --> D["判定为重复车辆<br/>不重复入库"]
    C -- "VIN 不存在" --> E["新增车辆资产<br/>状态=在库"]
    D --> F["导入结果汇总<br/>新增/重复/失败明细"]
    E --> F

    G["老板端：维护指导比例口径"] --> H["系统记录旧口径/新口径/修改人/生效时间"]
    H --> I["新报单按最新比例口径判断"]
    H --> J["历史报单和合同口径快照不变"]

    K["销售端：新建报单"] --> L{"业务模式是否为整车销售？"}
    L -- "是：整车销售不做指导价确认" --> N["财务端：直接确认报单"]
    L -- "否：租赁 / 以租代售" --> M["系统读取当前老板指导比例口径"]
    M --> M1{"首付/押金比例和每期还款比例<br/>是否均不低于指导口径？"}
    M1 -- "是：均不低于" --> N
    M1 -- "否：有一项低于" --> O["老板端：价格特批审批"]
    O --> P{"老板是否通过？"}
    P -- "驳回" --> Q["报单终止/作废<br/>车辆保持或恢复在库"]
    P -- "通过" --> N
    N --> R["车辆锁定<br/>报单激活"]
    R --> S["运营上传线下合同"]
    S --> T["运营发起首次付款"]
    T --> U["财务对账公司收款清单"]
    U --> V{"首次付款是否足额？"}
    V -- "足额" --> W["允许进入出库"]
    V -- "不足额" --> X["销售说明不足原因和承诺归还时间"]
    X --> Y["老板审批是否同意不足额出库"]
    Y -- "同意" --> W
    Y -- "不同意" --> Z["老板发起退款<br/>财务退款，本单结束"]

    AA["老板端：全过程查看"] --> AB["可查看入库导入、报单、比例口径、审批、合同、首付、出库、对账、退车、过户、利润"]
    AA --> AC["只审批比例低于指导口径、首次付款不足出库、退车领导审批等关键例外"]
