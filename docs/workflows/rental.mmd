flowchart TD
    A["运营端：上传新车 Excel"] --> B["系统按车架号 VIN 去重入库"]
    B --> C["车辆进入车库 / 状态：在库"]
    C --> D["销售端：销售报单 / 新建报单"]
    D --> E["选择在库车辆"]
    E --> F["销售方式：经营租赁"]
    F --> G["填写客户、租期、每期还款、押金、起租日、收款方案"]
    G --> H{"押金比例和每期还款比例<br/>是否均不低于老板租赁指导口径？"}
    H -- "否：有一项低于" --> I["老板端：价格特批"]
    I --> J{"老板审批结果"}
    J -- "驳回" --> K["流程结束：报单作废<br/>车辆保持/恢复在库"]
    J -- "通过" --> L["财务端：确认租赁报单"]
    H -- "是：均不低于" --> L
    L --> M["财务直接确认<br/>不上传车场/厂家分期表<br/>不做分期表价格比对"]
    M --> N["车辆锁定<br/>报单状态：已激活"]
    N --> O["运营端：上传线下租赁合同"]
    O --> P["合同状态：待首付款"]
    P --> Q["运营端：发起首次付款<br/>租赁口径：押金 + 首期租金"]
    Q --> R["运营端：上传客户付款截图"]
    R --> S["财务端：上传公司收款清单<br/>核对实际到账"]
    S --> T{"首次付款是否足额？"}
    T -- "足额" --> U["财务确认无误"]
    U --> V["合同状态：待出库"]
    T -- "不足额" --> W["销售在首期对账单上报实收金额<br/>备注不足原因和剩余金额承诺归还时间"]
    W --> X["不足部分挂账为应收<br/>承诺期内不记录万5滞纳金"]
    X --> Y["老板审批不足额出库"]
    Y -- "同意" --> Z["车辆继续锁定<br/>允许出库"]
    Z --> V
    Y -- "不同意" --> AA["老板发起退款"]
    AA --> AB["财务执行退款流程"]
    AB --> AC["本单结束<br/>报单/合同终止，车辆释放回在库"]
    V --> AD["车管端：上传出库照片/出库单"]
    AD --> AE["车管点击：确认出库"]
    AE --> AF["车辆状态：租赁中"]

    AF --> AG["运营/销售：每期发起还款对账"]
    AG --> AH["财务端：核对公司收款清单、流水号"]
    AH --> AI{"本期实付与应还金额关系"}
    AI -- "等额" --> AJ["本期账单：已还款"]
    AI -- "多还" --> AK["沿用原多还款规则<br/>按确认期数预抵/冲抵后续账单"]
    AI -- "少还" --> AL["实付金额记录为本期还款<br/>差额挂账为本期应收"]
    AL --> AM["差额按万5/日统计滞纳金"]
    AM --> AN["滞纳金仅累计记录<br/>本车流程结束后由销售发起是否收取/减免"]
    AJ --> AO{"是否还有未还期数？"}
    AK --> AO
    AN --> AO
    AO -- "有" --> AG
    AO -- "无/租期结束" --> AP["销售端：发起退车<br/>同步处理累计滞纳金是否收取"]
    AP --> AQ["系统自动带出车辆、客户、合同、银行卡信息"]
    AQ --> AR["退车状态：待车管验车"]
    AR --> AS["车管填写验车信息、工具、损伤、照片"]
    AS --> AT["退车状态：待运营填写"]
    AT --> AU["运营填写租金、违章、ETC、保养、事故等数据"]
    AU --> AV["退车状态：待财务复核"]
    AV --> AW["财务复核扣款、押金、退款金额、退款账户"]
    AW --> AX["老板端：领导审批"]
    AX --> AY["财务端：执行出款"]
    AY --> AZ["车管/系统：车辆回库或待维修"]
    AZ --> BA["租赁流程结束"]
    BB["老板端"] --> BC["查看全过程：入库、报单、审批、合同、首付、出库、还款、退车、利润"]
