flowchart TD
    A["运营：上传新车 Excel"] --> B["系统读取 Excel 车辆数据"]
    B --> C{"按车架号与后台所有车辆比对"}
    C -- "车架号已存在" --> D["跳过重复车辆<br/>不重复入库，记录导入结果"]
    C -- "车架号不存在" --> E["写入车辆资产<br/>vehicles.status=在库"]
    D --> F["导入完成：展示新增/重复/失败明细"]
    E --> F

    F --> G["销售：保存草稿或提交报单"]
    G --> H{"提交报单？"}
    H -- "草稿" --> I["sales_orders.order_status=草稿<br/>不锁车，7天有效"]
    H -- "提交" --> J["校验车辆在库、无进行中报单、客户黑名单"]
    J --> K{"业务模式是否为整车销售？"}
    K -- "是：整车销售不做指导价确认" --> N
    K -- "否：租赁 / 以租代售" --> K1{"首付/押金比例和每期还款比例<br/>是否均不低于老板指导口径？"}
    K1 -- "否：有一项低于" --> L["老板：价格特批"]
    L -- "驳回" --> M["报单已作废<br/>车辆保持/恢复在库"]
    L -- "通过" --> N["财务确认报单"]
    K1 -- "是：均不低于" --> N

    N --> O["财务直接确认租赁/以租代售/销售报单<br/>不再上传车场/厂家分期表<br/>不再做价格比对"]
    O --> P["车辆锁定<br/>vehicles.status=报单锁定中<br/>sales_orders.order_status=已激活"]
    P --> Q["运营上传线下签署合同"]
    Q --> R["运营端：上传客户付款截图"]
    R --> S["财务上传公司收款清单<br/>核对实际到账金额"]
    S --> T{"首次付款是否足额？"}

    T -- "足额" --> U["财务确认首次付款无误"]
    U --> V["合同进入待出库"]

    T -- "不足额" --> W["销售在首期对账单上报实收金额<br/>填写不足原因和剩余金额承诺归还时间"]
    W --> X["不足部分挂账为应收<br/>承诺期内不按万5计滞纳金"]
    X --> Y["老板审批首次付款不足出库"]
    Y -- "同意" --> Z["车辆继续锁定<br/>不足金额保留为应收<br/>允许出库"]
    Y -- "不同意" --> AA["老板发起退款"]
    AA --> AB["财务执行退款流程"]
    AB --> AC["本单结束<br/>报单/合同终止，车辆释放回在库"]
    Z --> V

    V --> AD["车管上传出库资料"]
    AD --> AE["车管确认出库"]
    AE --> AF{"合同类型"}
    AF -- "租赁" --> AG["车辆=租赁中<br/>进入每期还款/催收/退车"]
    AF -- "以租代售" --> AH["车辆=以租代售<br/>进入每期还款/过户"]
    AF -- "销售" --> AI["车辆=已售<br/>合同=已结清"]

    AG --> AJ["H1：每日批处理<br/>临近还款/还款日/逾期N日"]
    AH --> AJ
    AJ --> AK["每期付款：销售/运营登记客户实付<br/>财务上传收款清单并核销"]
    AK --> AL{"本期实付与应还金额关系"}
    AL -- "等额" --> AM["本期已还款"]
    AL -- "多还" --> AN["沿用原多还款规则<br/>按确认期数预抵/冲抵后续账单"]
    AL -- "少还" --> AO["实付金额记为本期已收<br/>差额挂账为本期应收"]
    AO --> AP["差额自逾期日起按万5/日统计滞纳金"]
    AP --> AQ["滞纳金仅累计记录<br/>本车流程结束后由销售发起是否收取/减免"]
    AM --> AR{"是否结清？"}
    AN --> AR
    AQ --> AR

    AR -- "租赁末期结清" --> AS["销售发起退车<br/>同时处理累计滞纳金是否收取"]
    AR -- "以租代售全部结清" --> AT["生成或发起过户单<br/>同时处理累计滞纳金是否收取"]
    AR -- "未结清" --> AJ

    AS --> AU["车管验车"]
    AU --> AV["运营查数据"]
    AV --> AW["财务复核"]
    AW --> AX["老板领导审批"]
    AX --> AY["财务出款"]
    AY --> AZ["车辆回库或待维修<br/>合同已退车/已结清"]

    AT --> BA["运营登记过户"]
    BA --> BB["车辆=已售/已过户<br/>合同=已结清"]
