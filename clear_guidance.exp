#!/usr/bin/expect -f
set timeout 60
set password "fijSec-tuccyt-9dohxu"
set server "8.156.91.120"

spawn ssh -o StrictHostKeyChecking=no root@$server
expect "password:"
send "$password\r"
expect "# "

send "cd /opt/jinjuyuan && /opt/jinjuyuan-venv/bin/python3 << 'EOF'\r"
expect "> "
send "import sqlite3, os\r"
expect "> "
send "os.chdir('/opt/jinjuyuan')\r"
expect "> "
send "c = sqlite3.connect('jinjuyuan.db').cursor()\r"
expect "> "
send "c.execute('DELETE FROM model_guidance_prices')\r"
expect "> "
send "r1 = c.rowcount\r"
expect "> "
send "c.execute('DELETE FROM model_guidance_price_history')\r"
expect "> "
send "r2 = c.rowcount\r"
expect "> "
send "c.connection.commit()\r"
expect "> "
send "c.execute('SELECT COUNT(*) FROM model_guidance_prices')\r"
expect "> "
send "print('guidance_prices:', r1, 'history:', r2, 'remain:', c.fetchone()[0])\r"
expect "> "
send "c.execute(\"SELECT id FROM vehicles WHERE vin='LFNA4LDC6TAE31340'\")\r"
expect "> "
send "v = c.fetchone()\r"
expect "> "
send "if v:\r"
expect "> "
send "  for t in ['vehicle_guidance_price_history','sales_orders','contracts','repayments','factory_repayments']:\r"
expect "> "
send "    c.execute(f'DELETE FROM {t} WHERE vehicle_id={v[0]}')\r"
expect "> "
send "  c.execute(f'DELETE FROM vehicles WHERE id={v[0]}')\r"
expect "> "
send "  c.connection.commit()\r"
expect "> "
send "  print('DELETED vehicle', v[0])\r"
expect "> "
send "else:\r"
expect "> "
send "  print('vehicle already gone')\r"
expect "> "
send "EOF\r"
expect "# "

send "pkill -f gunicorn; sleep 2\r"
expect "# "
send "cd /opt/jinjuyuan && source /opt/jinjuyuan-venv/bin/activate && nohup gunicorn -b 0.0.0.0:8081 -w 1 --threads 8 --timeout 120 wsgi:application >/tmp/gunicorn.log 2>&1 &\r"
expect "# "
sleep 5
send "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8081/\r"
expect -re "(\\d+)"
puts "HTTP: $expect_out(1,string)"

send "exit\r"
expect eof
