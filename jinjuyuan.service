[Unit]
Description=Jinjuyuan Vehicle Management System
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/jinjuyuan
EnvironmentFile=/opt/jinjuyuan/.env
ExecStart=/opt/jinjuyuan-venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 0.0.0.0:8081 wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
