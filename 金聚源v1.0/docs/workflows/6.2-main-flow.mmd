flowchart TD
    A["销售：保存草稿或提交报单"] --> B{"提交报单？"}
    B -- "草稿" --> C["sales_orders.order_status=草稿<br/>不锁车，7天有效"]
    B -- "提交" --> D["校验车辆在库、无进行中报单、客户黑名单、双指导价"]
    D --> E["锁车：vehicles.status=报单锁定中"]
    E --> F{"报价低于对应指导价？"}
    F -- "是" --> G["老板：价格特批"]
    G -- "驳回" --> H["报单已作废<br/>车辆恢复在库"]
    G -- "通过" --> I["order_status=待财务确认"]
    F -- "否" --> I

    I --> J["F1：生成客户计划<br/>repayments.status=未激活"]
    J --> K["财务上传厂家计划"]
    K --> L["F3：利差区间校验<br/>期数/首末期仅展示"]
    L --> M{"比对通过或差异已确认？"}
    M -- "否" --> K
    M -- "是" --> N["财务确认报单<br/>sales_orders.order_status=已激活"]

    N --> O["运营上传线下签署合同"]
    O --> Q["contracts.delivery_status=待首付款"]

    Q --> R["运营登记首付/押金+首期<br/>客户付款截图必填"]
    R --> S["财务上传流水号和到账金额"]
    S --> T["财务审核首次付款"]
    T --> U["写回首付/押金状态<br/>租赁自动核销首期<br/>剩余未激活计划改待还款"]
    U --> V["车管上传出库资料"]
    V --> W["车管确认出库"]
    W --> X{"合同类型"}
    X -- "租赁" --> Y["车辆=租赁中<br/>进入还款/催收/退车"]
    X -- "以租代售" --> Z["车辆=以租代售<br/>进入还款/过户"]
    X -- "销售" --> AA["车辆=已售<br/>合同=已结清"]

    Y --> AB["H1：每日批处理<br/>临近还款/还款日/逾期N日"]
    Z --> AB
    AB --> AC["I1/I2：运营登记客户还款<br/>财务核销"]
    AC --> AD{"是否结清？"}
    AD -- "租赁末期结清" --> AE["销售发起退车"]
    AD -- "以租代售全部结清" --> AF["生成或发起过户单"]
    AD -- "未结清" --> AB

    AE --> AG["车管验车"]
    AG --> AH["运营查数据"]
    AH --> AI["财务复核"]
    AI --> AJ["老板领导审批"]
    AJ --> AK["财务出款"]
    AK --> AL["车辆回库或待维修<br/>合同已退车/已结清"]

    AF --> AM["运营登记过户"]
    AM --> AN["车辆=已售/已过户<br/>合同=已结清"]
